#include <iostream>
using namespace std;

int main() {
    int arr[] = {10, 20, 30, 40, 50};
    int n = 5;
    int key = 30;

    int i;
    for (i = 0; i < n; i++) {
        if (arr[i] == key) {
            cout << "Element found at index " << i;
            break;
        }
    }

    if (i == n)
        cout << "Element not found";

    return 0;
}
